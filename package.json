{
	"name": "onyx-styles",
	"private": true,
	"description": "Tooling for building, linting and formatting the project's SCSS/CSS.",
	"scripts": {
		"build:css": "node scripts/build-css.mjs",
		"build:css:check": "node scripts/build-css.mjs --check",
		"format": "prettier --write \"frontend/src/**/*.scss\" \"!frontend/src/components/**\"",
		"format:check": "prettier --check \"frontend/src/**/*.scss\" \"!frontend/src/components/**\"",
		"lint:style": "stylelint \"frontend/src/**/*.scss\" --ignore-pattern \"frontend/src/components/**\"",
		"lint:style:fix": "stylelint --fix \"frontend/src/**/*.scss\" --ignore-pattern \"frontend/src/components/**\""
	},
	"devDependencies": {
		"autoprefixer": "10.6.2",
		"postcss": "8.5.32",
		"prettier": "^3.4.2",
		"sass": "1.106.1",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-prettier": "^5.0.2"
	}
}
