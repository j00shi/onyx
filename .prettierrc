{
	"semi": true,
	"singleQuote": false,
	"trailingComma": "es5",
	"printWidth": 120,
	"tabWidth": 4,
	"useTabs": true,
	"bracketSpacing": true,
	"arrowParens": "always",
	"vueIndentScriptAndStyle": true,
	"endOfLine": "lf",
	"overrides": [
		{
			"files": "*.scss",
			"options": {
				"singleQuote": false,
				"tabWidth": 4,
				"useTabs": true,
				"printWidth": 120
			}
		}
	]
}
